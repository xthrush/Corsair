<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      net6.0 and net8.0 are the concrete runnable targets that correspond to
      the two non-netstandard TFMs in the Corsair library. netstandard2.0 is
      a library compatibility target, not a runnable test host.
    -->
    <TargetFrameworks>net6.0;net8.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.0" />
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Corsair\Corsair.csproj" />
  </ItemGroup>

</Project>
